<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bridge hands Wine's environment, DYLD_FALLBACK_LIBRARY_PATH included, to x87sidecar.
	     Without this, the hardened runtime removes the DYLD_ variables before the bridge runs. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
