+        const auto& insn = localIR[i];
+        for (unsigned operand = 0; operand < std::min<unsigned>(insn.num_operands, 4); ++operand) {
+            const auto& op = insn.operands[operand];
+            if (op.mem.kind == IROperandKind::MemRef && op.mem.seg_override == 2) {
+                stock_hash_hit = true;
+                static unsigned gs_fallbacks = 0;
+                if (++gs_fallbacks <= 5) {
+                    fprintf(stdout, "[rosettax87] GS/TLS block handed to stock before custom emission\n");
+                    fflush(stdout);
+                }
+                break;
+            }
+        }
+    }
